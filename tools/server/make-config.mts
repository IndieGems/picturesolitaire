      y.push(`    stack_size: ${SUITCASE.stack}`);
      y.push("    transfer_policy: none");
      y.push("    client_writable: false");
    }
  }
}
y.push(END);
const block = y.join("\n");

let text = readFileSync(CONFIG, "utf8").replace(/\r\n/g, "\n");
const a = text.indexOf(BEGIN);
const b = text.indexOf(END);
if (a >= 0 && b > a) text = text.slice(0, a) + block + text.slice(b + END.length);
else text = text.replace(/\n*$/, "\n\n") + block + "\n";

// the cosmetics catalog: its own marked block at the end of the catalogs list (written there the
// first time, before the comments that head the next section)
{
  const C_BEGIN = "  # >>> cosmetics: generated by tools/server/make-config.mts from src/net/tables.json and src/net/tracks.json; do not edit by hand";
  const C_END = "  # <<< cosmetics";
  const c = [C_BEGIN];
  if (SOLD.length) {
    c.push("  # THE COSMETICS SCREEN (the creator, 2026-10-29): each shop table and soundtrack bought once");
    c.push("  # for Coins, the same direct platform order as a helper. A buy grants one copy; max_uses 1 and");
    c.push("  # the item's stack_size 1 refuse a second buy, a double press or a resend after a timeout");
    c.push("  # before anything is charged. The event tables have no offer here, and none anywhere else.");
    c.push(`  - id: ${uuid5("catalog:cosmetics")}`);
    c.push("    slug: cosmetics");
    c.push("    display_name: Cosmetics");
    c.push("    recipes:");
    SOLD.forEach((t, i) => {
      c.push(`      - id: ${uuid5(`recipe:buy-${t.slug}`)}`);
      c.push(`        slug: buy-${t.slug}`);
      c.push("        recipe_type: purchase");
      c.push(`        display_name: ${JSON.stringify(t.title)}`);
      c.push("        max_uses: 1");
      c.push(`        sort_order: ${i + 1}`);
      c.push("        grants:");
      c.push(`          - { type: item_grant, item_definition_slug: ${t.slug}, quantity: 1 }`);
      c.push("        platform_prices:");
      c.push(`          - { currency: ARCADE_TICKETS, price: ${t.price} }`);
    });
  }
  c.push(C_END);
  const ca = text.indexOf(C_BEGIN);
  const cb = text.indexOf(C_END);
  if (ca >= 0 && cb > ca) text = text.slice(0, ca) + c.join("\n") + text.slice(cb + C_END.length);
  else {
    const start = text.indexOf("\ncatalogs:\n");
    if (start < 0) {
      console.error("make-config: gem-backend-game-config.yaml has no catalogs section (the helpers' catalog) to put the cosmetics catalog in");
      process.exit(1);
    }
    const lines = text.slice(start + 1).split("\n");
    let at = lines.findIndex((l, i) => i > 0 && /^[a-z_]+:/.test(l));
    if (at < 0) at = lines.length;
    while (at > 1 && (lines[at - 1].startsWith("#") || lines[at - 1].trim() === "")) at--;
    lines.splice(at, 0, ...c);
    text = text.slice(0, start + 1) + lines.join("\n");
  }
  // no event table is sold, here or by any other offer in the catalogs
  const from = text.indexOf("\ncatalogs:\n");
  const rest = text.slice(from + 1).split("\n");
  const upto = rest.findIndex((l, i) => i > 0 && /^[a-z_]+:/.test(l));
  const catalogs = rest.slice(0, upto < 0 ? undefined : upto).join("\n");
  const sold = TABLES.filter((t) => t.award !== "shop" && (catalogs.includes(`item_definition_slug: ${t.slug}`) || catalogs.includes(t.id)));
  if (sold.length) {
    console.error(`make-config: ${sold.map((t) => t.slug).join(", ")} ${sold.length > 1 ? "are" : "is"} offered in a catalog, but only a shop table is sold (the event tables stay unpurchasable)`);
    process.exit(1);
  }
}
writeFileSync(CONFIG, text);

// ---------------------------------------------------------------- docs/coins.md
const lane = (name) => rows.filter((r) => r.lane === name);
const sum = (rs) => rs.reduce((n, r) => n + r.coins, 0);
const camp = lane("campaign");
const ch = lane("challenge");
const md = [];
md.push("# What a win pays");
md.push("");
md.push("Coins only, never Gems. Every payout is made by the win checker (`functions/checker`)");
md.push("after it has replayed the board's winning line on the rules, through one progression per");
md.push("board in the game config, so **each board pays once, ever**, and a resent claim or a");
md.push("replay pays nothing. Written by `node tools/server/make-config.mts`; do not edit by hand.");
md.push("");
md.push("**The rule** (agreed with the lead, 2026-10-24): about 1.1 Coins per move of the board's");
md.push("stored winning line, rounded to 5. Campaign boards 10 to 40, challenge boards 10 to 50.");
md.push("A campaign board's stored line is a winning line, not necessarily the shortest; a challenge");
md.push("board's is its par, the fewest moves found. Its length stands in for how long the board");
md.push(`takes. Campaign board 1 pays the onboarding prize instead, ${ONBOARDING.coins}. The daily puzzle pays`);
md.push(`${DAILY_COINS}, once a day.`);
md.push("");
md.push("**A Souvenir** (the optional all-long bonus board after each trip, `docs/souvenirs.md`) pays");
md.push("what the better-paying of its trip's relief boards pays, once, ever (the lead, 2026-10-28: the");
md.push("creator's \"Coins like a relief board\", a bonus for the detour). By the rule its short line, about");
md.push("13 moves, would pay about 15; as a one-off per trip this adds about 350 Coins to the whole game");
md.push("and leaves the hourly rate where it is.");
md.push("");
md.push("## The hourly maths (the standard: about 500 an hour of ordinary play)");
md.push("");
if (camp.length) {
  const paid = camp.filter((r) => !r.onboarding);
  const avg = sum(paid) / paid.length;
  md.push(`- Campaign: ${camp.length} boards, ${sum(camp)} Coins in all (${sum(paid)} without the onboarding prize).`);
  md.push(`  The design puts a relaxed board at 2 to 4 minutes. At 3 minutes a board, ${Math.round(avg)} a board`);
  md.push(`  is about ${Math.round((avg * 60) / 3)} Coins an hour; at 2 minutes ${Math.round((avg * 60) / 2)}, at 4 minutes ${Math.round((avg * 60) / 4)}.`);
}
if (ch.length) {
  const avg = sum(ch) / ch.length;
  md.push(`- Challenge route: ${ch.length} boards, ${sum(ch)} Coins in all, ${Math.round(avg)} a board on average.`);
  md.push(`  At 4 minutes a board that is about ${Math.round((avg * 60) / 4)} an hour; at 5 minutes ${Math.round((avg * 60) / 5)}.`);
}
md.push(`- Daily: ${DAILY_COINS} once a day, on top.`);
const sv = lane("souvenir");
md.push(sv.length ? `- Souvenirs: ${sv.length} of ${TRIPS.length} trips dealt, ${sum(sv)} Coins in all, once each (${sv.map((r) => `${r.id} ${r.coins}`).join(", ")}).` : "- Souvenirs: none dealt yet (Levels' src/content/levels/souvenirs.json).");
md.push("- One-time: the onboarding prize. Replays and campaign boards past the last pay nothing.");
md.push("- **Still to measure**: real minutes per board once the creator has played some (the lead's");
md.push("  note): if boards run much faster or slower than 2 to 4 minutes, change the rule here.");
md.push("");
md.push("## Board by board");
md.push("");
md.push("| board | lane | stored winning line (moves) | Coins |");
md.push("|---|---|---|---|");
for (const r of rows) md.push(`| ${r.id} | ${r.lane} ${r.n} | ${r.moves} | ${r.coins}${r.onboarding ? " (onboarding prize)" : ""} |`);
md.push("");
writeFileSync(join(root, "docs/coins.md"), md.join("\n"));
console.log(`config: ${rows.length} board progressions (${camp.length} campaign, ${ch.length} challenge, ${lane("souvenir").length} souvenir), the daily, its run type and board; docs/coins.md`);
