// Writes what the win checker pays into the game config, from the level files:
// one progression per campaign and challenge board, the daily challenge, and the
// daily result board. It replaces the block between the two "server:" marker
// lines in gem-backend-game-config.yaml (appending it the first time), and
// writes docs/coins.md, the table of what each board pays and the hourly maths.
//
//   node tools/server/make-config.mts
//
// Then: gemctl config upload --dry-run, and gemctl config upload --channel dev.
// Run it again whenever a level file gains boards: a board with no progression
// is verified but cannot pay (the function answers "retry", reason "config").
//
// THE AMOUNTS (agreed with the lead, 2026-10-24; the game standard's ~500 Coins
// an hour): about 1.1 Coins per move of the board's stored winning line, rounded
// to 5; 10 to 40 for a campaign board, 10 to 50 for a challenge board. A
// campaign board's stored line is A winning line, not the shortest; a challenge
// board's is its par (the fewest moves found). The line's length stands in for
// how long a board takes until real minutes per board are measured. The first campaign board, where onboarding is played, pays the
// onboarding prize instead: 100. The daily pays 50, once a day.
// Every progression is written only by the function (function_may_grant): it
// replays the win before it moves one.
// @ts-nocheck: Node runs this file; it is not part of the game's TypeScript build.

import { createHash } from "node:crypto";
import { existsSync, readFileSync, writeFileSync } from "node:fs";
import { dirname, join } from "node:path";
import { fileURLToPath } from "node:url";


const root = join(dirname(fileURLToPath(import.meta.url)), "../..");
{
  const { levelsDirty } = await import("./levels-hash.mts");
  const dirty = levelsDirty();
  if (dirty && !process.argv.includes("--allow-dirty")) {
    console.error(`make-config: the level files have uncommitted changes:
${dirty}
Write the config from what the levels member committed, or pass --allow-dirty.`);
    process.exit(1);
  }
}
function TABLES_FILE() {
  return JSON.parse(readFileSync(join(root, "src/net/tables.json"), "utf8")).tables;
}
/** The table items (src/net/tables.json): cosmetic, granted only through this config (the suitcase tables are added below). */
let TABLES = TABLES_FILE();
const CONFIG = join(root, "gem-backend-game-config.yaml");
const BEGIN = "# >>> server: generated by tools/server/make-config.mts from src/content/levels; do not edit by hand";
const END = "# <<< server";

/** Must match functions/checker/src/lib.rs (DAILY_ID, DAILY_SLUG, DAILY_RUN). */
const DAILY_ID = "6d1f3b0e-8a52-4c7e-9f14-2b6e0d9a7c31";
const DAILY_SLUG = "daily_picture";
const DAILY_RUN = "daily_result";
/** The onboarding prize: the keepsake table entry in src/net/tables.json says which board and how many Coins (the game shows the same number). */
const KEEP = TABLES_FILE().find((t) => t.award === "onboarding");
const ONBOARDING = { board: KEEP?.board ?? "c01", coins: KEEP?.coins ?? 100 };
const DAILY_COINS = 50;
const LANES = { campaign: { label: "Campaign board", most: 40 }, challenge: { label: "Challenge board", most: 50 } };

/** A board's Coins, from the moves of its stored winning line. */
export const coinsFor = (moves, most) => Math.max(10, Math.min(most, Math.round((moves * 1.1) / 5) * 5));

/** A name-based UUID (RFC 4122 version 5) in this game's own namespace, so a board's id never changes. */
const NAMESPACE = "9c562125-f155-4601-a349-f66ca3c5f2b6"; // the Gem game id
function uuid5(name) {
  const ns = Buffer.from(NAMESPACE.replace(/-/g, ""), "hex");
  const h = createHash("sha1").update(Buffer.concat([ns, Buffer.from(name, "utf8")])).digest();
  h[6] = (h[6] & 0x0f) | 0x50;
  h[8] = (h[8] & 0x3f) | 0x80;
  const x = h.subarray(0, 16).toString("hex");
  return `${x.slice(0, 8)}-${x.slice(8, 12)}-${x.slice(12, 16)}-${x.slice(16, 20)}-${x.slice(20, 32)}`;
}

// THE DAILY SUITCASE (docs/daily-suitcase.md; functions/checker/src/suitcase.rs): Levels'
// months (src/content/levels/suitcases.json) and the fixed ids (src/net/suitcase-ids.json).
// Each month's table that is not the built-in one is a table item: its entry in
// src/net/tables.json is added here (award "suitcase", the month), its id made once from its
// slug and kept, its title and icon following Art's.
const SUITCASE = JSON.parse(readFileSync(join(root, "src/net/suitcase-ids.json"), "utf8"));
const SCHEDULE = join(root, "src/content/levels/suitcases.json");
const MONTHS = existsSync(SCHEDULE) ? JSON.parse(readFileSync(SCHEDULE, "utf8")).months : [];
const markSlug = (month) => `suitcase_prize_${month.replace("-", "_")}`;
{
  const file = join(root, "src/net/tables.json");
  const doc = JSON.parse(readFileSync(file, "utf8"));
  const before = JSON.stringify(doc);
  for (const m of MONTHS) {
    if (!m.table || m.table === SUITCASE.builtInTable) continue;
    const title = /table$/i.test(m.tableTitle ?? "") ? m.tableTitle : `${m.tableTitle ?? m.theme} table`;
    const icon = `tools/art/items/${m.table}.png`;
    let t = doc.tables.find((x) => x.slug === m.table);
    if (!t) doc.tables.push((t = { slug: m.table, id: uuid5(`table:${m.table}`) }));
    Object.assign(t, { title, award: "suitcase", month: m.month });
    if (existsSync(join(root, icon))) t.icon = icon;
  }
  if (JSON.stringify(doc) !== before) {
    writeFileSync(file, JSON.stringify(doc, null, 2) + "\n");
    console.log("config: src/net/tables.json gains or updates the suitcase tables");
  }
  TABLES = doc.tables;
}
{
  // the suitcase's events are recorded by the checker under a declared month: every month needs declaring
  const text = readFileSync(CONFIG, "utf8");
  for (const id of ["suitcase_item", "suitcase_swap", "suitcase_complete"]) {
    const at = text.indexOf(`- id: ${id}\n`);
    const block = at < 0 ? "" : text.slice(at, text.indexOf("\n  - id:", at + 1));
    const missing = MONTHS.filter((m) => !block.includes(`"${m.month}"`)).map((m) => m.month);
    if (at < 0 || missing.length) {
      console.error(`make-config: analytics event ${id} ${at < 0 ? "is not declared" : `does not declare the month${missing.length > 1 ? "s" : ""} ${missing.join(", ")}`} (gem-backend-game-config.yaml, analytics_events)`);
      process.exit(1);
    }
  }
}

const rows = [];
for (const [lane, { label, most }] of Object.entries(LANES)) {
  const file = join(root, "src/content/levels", `${lane}.json`);
  if (!existsSync(file)) continue;
  JSON.parse(readFileSync(file, "utf8")).levels.forEach((l, i) => {
    const moves = l.line.length;
    const coins = l.id === ONBOARDING.board ? ONBOARDING.coins : coinsFor(moves, most);
    rows.push({ lane, id: l.id, n: i + 1, label: `${label} ${i + 1}`, moves, coins, onboarding: l.id === ONBOARDING.board });
  });
}

const y = [];
y.push(BEGIN);
y.push("# What the win checker (functions/checker) pays, in Coins. One progression per");
y.push("# board: completion 1 and no reset, so its Coins are paid the first time the");
y.push("# function moves it, and never again. Amounts and the hourly maths: docs/coins.md.");
y.push("progressions:");
for (const r of rows) {
  y.push(`  - id: ${uuid5(`board:${r.lane}:${r.id}`)}`);
  y.push(`    slug: board_${r.id}`);
  y.push(`    display_name: "${r.label}"`);
  y.push("    config:");
  y.push("      completion_threshold: 1");
  y.push("      function_may_grant: true");
  y.push("      platform_grants:");
  y.push(`        - mode: on_complete${r.onboarding ? "   # the onboarding prize: onboarding is played on this board" : ""}`);
  y.push(`          amount: ${r.coins}`);
  y.push("          target: { platform_currency_slug: ARCADE_TICKETS }");
  const granted = TABLES.filter((t) => r.lane === "campaign" && t.board === r.id);
  if (granted.length) {
    y.push("      # granted with the prize, once (src/net/tables.json)");
    y.push("      rewards_on_complete:");
    for (const t of granted) {
      y.push("        - type: item_grant");
      y.push(`          item_definition_id: ${t.id}   # ${t.slug} (the backend wants the id here)`);
      y.push("          quantity: 1");
    }
  }
}
{
  // the kit's mark (src/net/helper-ids.json): set by the checker in the same order as the kit
  const KIT = JSON.parse(readFileSync(join(root, "src/net/helper-ids.json"), "utf8")).kit;
  y.push("  # THE HELPER KIT: 3 of each helper, once ever, at the end of board 1 (the guided start),");
  y.push("  # or on the next win of a player already past it. The win checker pays it into the");
  y.push("  # helper currencies and sets this to 1 in the same order, so it is paid once or not at all.");
  y.push(`  - id: ${KIT.progression}`);
  y.push(`    slug: ${KIT.slug}`);
  y.push(`    display_name: "Helper kit"`);
  y.push("    config:");
  y.push("      completion_threshold: 1");
}
y.push("  # THE DAILY PUZZLE: one board a day, the same for everyone (src/content/levels/daily.json,");
y.push("  # the board \"d\" + the date). The function checks the date is the player's own today,");
y.push("  # posts moves and time to the \"daily\" board below, and completes this once a day.");
y.push(`  - id: ${DAILY_ID}`);
y.push(`    slug: ${DAILY_SLUG}`);
y.push(`    display_name: "Today's picture"`);
y.push(`    description: "Mend the day's picture: the same board for every player."`);
y.push("    config:");
y.push("      completion_threshold: 1");
y.push("      # local: an untimed puzzle compared among friends, so each player's own day is fair");
y.push("      # enough, and nobody's daily turns over in the middle of their afternoon");
y.push("      reset_schedule: { type: daily, boundary: local }");
y.push("      platform_display: challenge");
y.push("      function_may_grant: true");
y.push("      platform_grants:");
y.push("        - mode: on_complete");
y.push(`          amount: ${DAILY_COINS}`);
y.push("          target: { platform_currency_slug: ARCADE_TICKETS }");
if (MONTHS.length) {
  y.push("  # THE DAILY SUITCASE, the monthly event (docs/daily-suitcase.md): the Arcade shows this");
  y.push("  # challenge; the win checker keeps its meter at the month's items held (the day's item");
  y.push("  # is packed by the daily's first win, a swap adds one). It pays nothing itself: a full");
  y.push("  # suitcase's table and helpers are the checker's own order, once (the marks below).");
  y.push(`  - id: ${SUITCASE.event.id}`);
  y.push(`    slug: ${SUITCASE.event.slug}`);
  y.push(`    display_name: "Daily Suitcase"`);
  y.push(`    description: "Pack each day's travel item from the daily picture, until all {target} are in this month's suitcase."`);
  y.push("    config:");
  y.push(`      completion_threshold: ${MONTHS[0].items.length}`);
  y.push("      reset_schedule: { type: monthly, boundary: local }");
  y.push("      platform_display: challenge");
  y.push("  # Each month's suitcase paid: moved to 1 by the checker in the same order as its table and");
  y.push("  # helpers, so it lands with them or not at all, once.");
  for (const m of MONTHS) {
    y.push(`  - id: ${uuid5(`suitcase:prize:${m.month}`)}`);
    y.push(`    slug: ${markSlug(m.month)}`);
    y.push(`    display_name: "Suitcase ${m.month} full"`);
    y.push("    config:");
    y.push("      completion_threshold: 1");
  }
}
y.push("");
y.push("# A daily result, posted by the function once it has replayed the win: the");
y.push("# player's first verified result of the day (one run id per player per date).");
y.push("run_types:");
y.push(`  - id: ${DAILY_RUN}`);
y.push("    int_value_1_name: moves");
y.push("    int_value_2_name: time_ms");
y.push(`    challenge: ${DAILY_ID}`);
y.push("");
y.push("# The day's results, for comparing with friends (gem.leaderboards.friends): fewest");
y.push("# moves first, then the quicker time. One board per date (per_period).");
y.push("leaderboards:");
y.push("  - id: daily");
y.push(`    run_type: ${DAILY_RUN}`);
y.push("    order_by:");
y.push("      - { column: int_value_1, direction: asc }");
y.push("      - { column: int_value_2, direction: asc }");
y.push("    per_period: true");
y.push("    max_size: 100");
y.push("    update_frequency_seconds: 300");
if (TABLES.length) {
  y.push("");
  y.push("# Tables the player can own (src/net/tables.json): cosmetic, never traded, never");
  y.push("# written by the game (client_writable false); granted only through the config above.");
  y.push("items:");
  for (const t of TABLES) {
    y.push(`  - id: ${t.id}`);
    y.push(`    slug: ${t.slug}`);
    y.push(`    display_name: "${t.title}"`);
    y.push("    item_type: item");
    y.push("    category: cosmetic");
    y.push("    fungible: true");
    y.push("    stack_size: 1");
    y.push("    transfer_policy: none");
    y.push("    client_writable: false");
    if (t.icon) y.push(`    icon: ${t.icon}`);
  }
}
if (MONTHS.length) {
  y.push("# The suitcase items (src/content/levels/suitcases.json): a copy held per day packed, spares");
  y.push("# swapped by the checker; cosmetic, never traded, never written by the game.");
  if (!TABLES.length) y.push("items:");
  for (const m of MONTHS) {
    for (const it of m.items) {
      y.push(`  - id: ${uuid5(`suitcase:item:${it.id}`)}`);
      y.push(`    slug: ${it.id}`);
      y.push(`    display_name: ${JSON.stringify(it.title)}`);
      y.push("    item_type: item");
      y.push("    category: cosmetic");
      y.push("    fungible: true");
      y.push(`    stack_size: ${SUITCASE.stack}`);
      y.push("    transfer_policy: none");
      y.push("    client_writable: false");
    }
  }
}
y.push(END);
const block = y.join("\n");

let text = readFileSync(CONFIG, "utf8").replace(/\r\n/g, "\n");
const a = text.indexOf(BEGIN);
const b = text.indexOf(END);
if (a >= 0 && b > a) text = text.slice(0, a) + block + text.slice(b + END.length);
else text = text.replace(/\n*$/, "\n\n") + block + "\n";
writeFileSync(CONFIG, text);

// ---------------------------------------------------------------- docs/coins.md
const lane = (name) => rows.filter((r) => r.lane === name);
const sum = (rs) => rs.reduce((n, r) => n + r.coins, 0);
const camp = lane("campaign");
const ch = lane("challenge");
const md = [];
md.push("# What a win pays");
md.push("");
md.push("Coins only, never Gems. Every payout is made by the win checker (`functions/checker`)");
md.push("after it has replayed the board's winning line on the rules, through one progression per");
md.push("board in the game config, so **each board pays once, ever**, and a resent claim or a");
md.push("replay pays nothing. Written by `node tools/server/make-config.mts`; do not edit by hand.");
md.push("");
md.push("**The rule** (agreed with the lead, 2026-10-24): about 1.1 Coins per move of the board's");
md.push("stored winning line, rounded to 5. Campaign boards 10 to 40, challenge boards 10 to 50.");
md.push("A campaign board's stored line is a winning line, not necessarily the shortest; a challenge");
md.push("board's is its par, the fewest moves found. Its length stands in for how long the board");
md.push(`takes. Campaign board 1 pays the onboarding prize instead, ${ONBOARDING.coins}. The daily puzzle pays`);
md.push(`${DAILY_COINS}, once a day.`);
md.push("");
md.push("**A Souvenir** (the optional all-long bonus board after each trip, `docs/souvenirs.md`) pays");
md.push("what the better-paying of its trip's relief boards pays, once, ever (the lead, 2026-10-28: the");
md.push("creator's \"Coins like a relief board\", a bonus for the detour). By the rule its short line, about");
md.push("13 moves, would pay about 15; as a one-off per trip this adds about 350 Coins to the whole game");
md.push("and leaves the hourly rate where it is.");
md.push("");
md.push("## The hourly maths (the standard: about 500 an hour of ordinary play)");
md.push("");
if (camp.length) {
  const paid = camp.filter((r) => !r.onboarding);
  const avg = sum(paid) / paid.length;
  md.push(`- Campaign: ${camp.length} boards, ${sum(camp)} Coins in all (${sum(paid)} without the onboarding prize).`);
  md.push(`  The design puts a relaxed board at 2 to 4 minutes. At 3 minutes a board, ${Math.round(avg)} a board`);
  md.push(`  is about ${Math.round((avg * 60) / 3)} Coins an hour; at 2 minutes ${Math.round((avg * 60) / 2)}, at 4 minutes ${Math.round((avg * 60) / 4)}.`);
}
if (ch.length) {
  const avg = sum(ch) / ch.length;
  md.push(`- Challenge route: ${ch.length} boards, ${sum(ch)} Coins in all, ${Math.round(avg)} a board on average.`);
  md.push(`  At 4 minutes a board that is about ${Math.round((avg * 60) / 4)} an hour; at 5 minutes ${Math.round((avg * 60) / 5)}.`);
}
md.push(`- Daily: ${DAILY_COINS} once a day, on top.`);
md.push("- Souvenirs: none dealt yet (Levels' src/content/levels/souvenirs.json, when Art's pictures land).");
md.push("- One-time: the onboarding prize. Replays and campaign boards past the last pay nothing.");
md.push("- **Still to measure**: real minutes per board once the creator has played some (the lead's");
md.push("  note): if boards run much faster or slower than 2 to 4 minutes, change the rule here.");
md.push("");
md.push("## Board by board");
md.push("");
md.push("| board | lane | stored winning line (moves) | Coins |");
md.push("|---|---|---|---|");
for (const r of rows) md.push(`| ${r.id} | ${r.lane} ${r.n} | ${r.moves} | ${r.coins}${r.onboarding ? " (onboarding prize)" : ""} |`);
md.push("");
writeFileSync(join(root, "docs/coins.md"), md.join("\n"));
console.log(`config: ${rows.length} board progressions (${camp.length} campaign, ${ch.length} challenge), the daily, its run type and board; docs/coins.md`);
