}
if (COUNTERS.length) {
  y.push("  # THE ACHIEVEMENTS (the creator, 2026-10-30; docs/achievements.md; src/net/achievements.json):");
  y.push("  # one counter per group, set only by the win checker, to what the player's progress record");
  y.push("  # says (progression_max, on every verified win, so wins from before count too), never by the");
  y.push("  # game or by anything else in this config. Each achievement unlocks once, ever, when its");
  y.push("  # counter reaches its level's threshold, and only on release. Its id, points, rewards and");
  y.push("  # place are fixed at the first release: the points budget is lifetime.");
  for (const c of COUNTERS) {
    const own = copyOf("en", c);
    y.push(`  - id: ${c.id}`);
    y.push(`    slug: ${c.slug}`);
    y.push(`    display_name: ${JSON.stringify(own.name)}`);
    y.push(`    description: ${JSON.stringify(own.desc)}`);
    y.push(...localizedOf(c, undefined, 4));
    y.push("    config:");
    y.push("      function_may_grant: true");
    y.push("      tracks:");
    y.push("        - track_id: main");
    y.push("          levels:");
    c.achievements.forEach((a, i) => {
      const words = copyOf("en", c, a);
      y.push(`            - level: ${i + 1}   # ${a.slug}`);
      y.push(`              threshold: ${a.at}`);
      y.push("              platform_grants:");
      y.push("                - achievement:");
      y.push(`                    id: ${a.id}`);
      y.push(`                    points: ${a.points}`);
      y.push(`                    display_name: ${JSON.stringify(words.name)}`);
      y.push(`                    description: ${JSON.stringify(words.desc)}`);
      y.push(...localizedOf(c, a, 20));
      if (a.icon) {
        y.push("                    rewards:");
        y.push(`                      - item: ${a.icon}   # an Arcade avatar icon, Art's (gemctl item upload)`);
      }
    });
  }
}
y.push("");
y.push("# A daily result, posted by the function once it has replayed the win: the");
y.push("# player's first verified result of the day (one run id per player per date).");
y.push("run_types:");
y.push(`  - id: ${DAILY_RUN}`);
y.push("    int_value_1_name: moves");
y.push("    int_value_2_name: time_ms");
y.push(`    challenge: ${DAILY_ID}`);
y.push("");
y.push("# The day's results, for comparing with friends (gem.leaderboards.friends): fewest");
y.push("# moves first, then the quicker time. One board per date (per_period).");
y.push("leaderboards:");
y.push("  - id: daily");
y.push(`    run_type: ${DAILY_RUN}`);
y.push("    order_by:");
y.push("      - { column: int_value_1, direction: asc }");
y.push("      - { column: int_value_2, direction: asc }");
y.push("    per_period: true");
y.push("    max_size: 100");
y.push("    update_frequency_seconds: 300");
if (TABLES.length) {
  y.push("");
  y.push("# Tables the player can own (src/net/tables.json): cosmetic, never traded, never");
  y.push("# written by the game (client_writable false); granted only through the config above.");
  y.push("items:");
  for (const t of TABLES) {
    y.push(`  - id: ${t.id}`);
    y.push(`    slug: ${t.slug}`);
    y.push(`    display_name: "${t.title}"`);
    y.push("    item_type: item");
    y.push("    category: cosmetic");
    y.push("    fungible: true");
    y.push("    stack_size: 1");
    y.push("    transfer_policy: none");
    y.push("    client_writable: false");
