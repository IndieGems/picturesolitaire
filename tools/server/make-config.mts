    const icon = `tools/art/items/${e.table}.png`;
    let t = doc.tables.find((x) => x.slug === e.table);
    if (!t) doc.tables.push((t = { slug: e.table, id: uuid5(`table:${e.table}`) }));
    Object.assign(t, { title, award: "suitcase", event: e.id });
