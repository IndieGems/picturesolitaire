{
  "//": "Created when this project was added to the Gem tools. Declare dev processes, editors and launch settings here.",
  "schema": 1,
  "dev": {
    "game": {
      "process": {
        "id": "vite",
        "command": [
          "node",
          "node_modules/vite/bin/vite.js"
        ],
        "ports": [
          {
            "name": "port",
            "env": "GEM_VITE_PORT"
          }
        ],
        "ready": [
          {
            "name": "port",
            "prefix": "GEM_VITE_PORT "
          }
        ]
      },
      "url": "http://127.0.0.1:{vite.port}/"
    },
    "processes": [
      {
        "id": "soundtuning",
        "command": [
          "node",
          "tools/sound-tuning/server.mjs"
        ],
        "ports": [
          {
            "name": "port",
            "env": "SOUNDTUNING_PORT"
          }
        ],
        "ready": [
          {
            "name": "port",
            "prefix": "SOUNDTUNING_PORT "
          }
        ]
      },
      {
        "id": "pictures",
        "command": [
          "node",
          "tools/picture-library/server.mjs"
        ],
        "ports": [
          {
            "name": "port",
            "env": "PICTURES_PORT"
          }
        ],
        "ready": [
          {
            "name": "port",
            "prefix": "PICTURES_PORT "
          }
        ]
      },
      {
        "id": "tripscases",
        "command": [
          "node",
          "tools/trips-cases/server.mjs"
        ],
        "ports": [
          {
            "name": "port",
            "env": "TRIPSCASES_PORT"
          }
        ],
        "ready": [
          {
            "name": "port",
            "prefix": "TRIPSCASES_PORT "
          }
        ]
      }
    ]
  },
  "editors": [
    {
      "id": "sound-tuning",
      "label": "Sound Tuning",
      "kind": "web",
      "url": "http://127.0.0.1:{soundtuning.port}/"
    },
    {
      "id": "picture-library",
      "label": "Picture Library",
      "kind": "web",
      "url": "http://127.0.0.1:{pictures.port}/"
    },
    {
      "id": "trips-cases",
      "label": "Trips & Cases",
      "kind": "web",
      "url": "http://127.0.0.1:{tripscases.port}/"
    }
  ]
}
